# Copy to .env and change. SQL Server requires 8+ characters with three of:
# upper case, lower case, digits, symbols. Do not use single quotes.
SA_PASSWORD=Poc-Sa-2026!change
DAB_READER_PASSWORD=Poc-Dab-Reader-2026!change
CIP_INGEST_PASSWORD=Poc-Ingest-2026!change

# Seconds between simulated source events
SIM_TICK_SECONDS=3

# Set to 1 to drop and rebuild the database on the next `docker compose up`
RESET_DB=0
