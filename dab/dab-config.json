        "object": "contract.vw_service_delivery",
        "type": "view"
      },
      "fields": [
        {
          "name": "estate_code",
          "primary-key": true
        }
      ],
      "rest": {
        "enabled": true
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "ServiceDelivery",
          "plural": "ServiceDeliveries"
        }
      },
      "permissions": [
        {
          "role": "client_reader",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
