{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v2.1.5/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('DAB_CONNECTION_STRING')",
    "options": {
      "set-session-context": true
    }
  },
  "runtime": {
    "rest": {
      "enabled": true,
      "path": "/api",
      "request-body-strict": true
    },
    "graphql": {
      "enabled": true,
      "path": "/graphql",
      "allow-introspection": true,
      "depth-limit": 4
    },
    "mcp": {
      "enabled": false
    },
    "host": {
      "mode": "development",
      "cors": {
        "origins": [],
        "allow-credentials": false
      },
      "authentication": {
        "provider": "AppService"
      }
    },
    "pagination": {
      "default-page-size": 100,
      "max-page-size": 1000
    },
    "cache": {
      "enabled": false
    }
  },
  "entities": {
    "vw_estate": {
      "description": "Coded estate master: tier, region, map position. No names stored.",
      "source": {
        "object": "contract.vw_estate",
        "type": "view"
      },
      "fields": [
        {
          "name": "estate_code",
          "primary-key": true
        }
      ],
      "rest": {
        "enabled": true
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "Estate",
          "plural": "Estates"
        }
      },
      "permissions": [
        {
          "role": "client_reader",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "vw_service_delivery": {
      "description": "M001-M003 \u00b7 open work orders, SLA % (rolling 30d), response, MTTR, PPM completion (90d), planned share (12m) per estate.",
