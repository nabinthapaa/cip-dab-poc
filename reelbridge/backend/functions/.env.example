# Copy to .env.<firebase-project-id> (NOT committed). Non-secret configuration only.
# Secrets (META_APP_SECRET, TOKEN_ENCRYPTION_KEY) are set with:
#   firebase functions:secrets:set META_APP_SECRET
#   firebase functions:secrets:set TOKEN_ENCRYPTION_KEY     (32 random bytes, base64: `openssl rand -base64 32`)

# Meta App ID (public). Must match the App ID compiled into the Android app.
META_APP_ID=
# Graph API version. Verify the current version at https://developers.facebook.com/docs/graph-api/changelog
META_GRAPH_VERSION=v26.0
# "binary" streams the file from Storage to Meta (no extra IAM).
# "hosted" gives Meta a 30-minute signed Storage URL (requires the functions service account to
# have roles/iam.serviceAccountTokenCreator on itself).
REELS_UPLOAD_MODE=binary
# Delete the Storage copy after the Reel is live.
DELETE_VIDEO_AFTER_PUBLISH=true
# Reject callable requests without a valid App Check token.
ENFORCE_APP_CHECK=true
